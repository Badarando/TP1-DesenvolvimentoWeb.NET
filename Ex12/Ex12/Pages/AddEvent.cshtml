@page
@model Ex12.Pages.AddEventModel

<h1>Cadastro de Eventos</h1>

<form method="post">
    <label>Título:</label>
    <input type="text" name="titulo" required />

    <br /><br />

    <label>Data:</label>
    <input type="date" name="data" required />

    <br /><br />

    <label>Local:</label>
    <input type="text" name="local" required />

    <br /><br />

    <button type="submit">Cadastrar Evento</button>
</form>

@if (Model.Cadastrado)
{
    <h2>Evento cadastrado com sucesso!</h2>

    <p>Título: @Model.Titulo</p>
    <p>Data: @Model.Data.ToString("dd/MM/yyyy")</p>
    <p>Local: @Model.Local</p>
}
